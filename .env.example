# =============================================================================
# 约个钓 后端环境变量模板
# 用法：cp .env.example .env，再把下面的占位值填成真实值
# 真实的 .env 不进 git（见 .gitignore），密码/IP 等敏感信息走线下同步
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库连接
# 格式：mysql://<用户>:<URL-encoded 密码>@<主机>:<端口>/<库名>
# 注意：密码里如果有 @ : / 等特殊字符，必须 URL-encode
#       例如 YueGeDiao@2026 中的 @ 要写成 %40
# -----------------------------------------------------------------------------

# —— 远程阿里云测试库（推荐：换机器/在家开发都连这个，数据一致） ——
# 主机请向团队成员索取，或参考服务器 IP 文档
DATABASE_URL="mysql://<用户>:<URL编码后的密码>@<阿里云IP>:3306/yue_ge_diao_dev"
SHADOW_DATABASE_URL="mysql://<用户>:<URL编码后的密码>@<阿里云IP>:3306/yue_ge_diao_shadow"

# —— 备选：本地 docker MySQL（需先起 yue-ge-diao-infra 里的 compose） ——
# DATABASE_URL="mysql://yuegediao:YueGeDiao%402026@127.0.0.1:3306/yue_ge_diao_dev"
# SHADOW_DATABASE_URL="mysql://root:<root密码URL编码>@127.0.0.1:3306/yue_ge_diao_shadow"

# -----------------------------------------------------------------------------
# 应用配置
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# JWT
# JWT_SECRET 生产环境务必换成强随机串
# access token 短期（30 分钟）；前端凭 refresh token 无感续期
# refresh token 长期（30 天）；到期才强制重登
# -----------------------------------------------------------------------------
JWT_SECRET=dev-secret-change-me-in-prod
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
