# =============================================================================
# 约个钓 后端环境变量（.env 不进 git，见 .gitignore）
# =============================================================================

# Prisma / 数据库连接
# 格式：mysql://<用户>:<URL-encoded 密码>@<主机>:<端口>/<库名>
# 注意：密码 YueGeDiao@2026 含 @，必须把 @ URL encode 成 %40
DATABASE_URL="mysql://yuegediao:YueGeDiao%402026@127.0.0.1:3306/yue_ge_diao_dev"

# Prisma 影子库连接（仅本地 dev 用，迁移期 Prisma 临时建库再删）
# 业务账号 yuegediao 没有 CREATE DATABASE 权限，所以 shadow 走 root
# 库名必须与 DATABASE_URL 不同，否则会清空业务数据
SHADOW_DATABASE_URL="mysql://root:YueGeDiao%402026Root@127.0.0.1:3306/yue_ge_diao_shadow"

# 应用端口
PORT=3000

# Node 环境
NODE_ENV=development

# JWT
JWT_SECRET=dev-secret-change-me-in-prod
JWT_EXPIRES_IN=7d
